# Copy to .env and adjust. Every setting in app/config.py can be set here.

DATABASE_URL=postgresql+asyncpg://tatkal:tatkal@localhost:5432/tatkal
REDIS_URL=redis://localhost:6379/0

# Zero-install local mode (no Postgres, no Redis):
# DATABASE_URL=sqlite+aiosqlite:///./tatkal.db
# REDIS_URL=fake://

JWT_SECRET=change-me-in-production
ADMIN_TOKEN=admin-secret
BCRYPT_ROUNDS=12

HOLD_TTL_SECONDS=300
MAX_ACTIVE_HOLDS_PER_USER=4
NAIVE_PROCESSING_DELAY_MS=50
PAYMENT_DELAY_MS=100

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=5
WAITING_ROOM_ENABLED=false
WAITING_ROOM_ADMIT_PER_SECOND=200

RUN_BACKGROUND_WORKERS=true
